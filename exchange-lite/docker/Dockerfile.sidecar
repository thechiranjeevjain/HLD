FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY . .
RUN mvn -q -pl sidecar -am package -DskipTests

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /src/common/target/exchange-lite-common-0.1.0.jar /app/
COPY --from=build /src/engine/target/exchange-lite-engine-0.1.0.jar /app/
COPY --from=build /src/sidecar/target/exchange-lite-sidecar-0.1.0.jar /app/
EXPOSE 8080
ENTRYPOINT ["java", "-cp", "/app/*", "io.exchangelite.sidecar.SidecarApplication"]
