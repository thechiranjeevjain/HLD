{
  "name": "system-design-projects-tooling",
  "private": true,
  "version": "1.0.0",
  "description": "Shared documentation tooling for all SystemDesignProjects subdirectories.",
  "scripts": {
    "diagram:example": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-mermaid.ps1 -Source docs/mermaid-example.mmd -Output docs/mermaid-example.svg",
    "docs:standardize": "node scripts/standardize-diagrams.mjs",
    "docs:format": "node scripts/format-docs.mjs",
    "docs:audit": "node scripts/audit-docs.mjs"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.16.0",
    "prettier": "3.6.2"
  }
}
